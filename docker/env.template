# Copy to ../.env (chmod 600) and fill in. Generate secrets with:
#   openssl rand -base64 32
# Never commit .env.

# Bearer token the browser needs from anywhere but the container's own loopback.
# Open http://localhost:${FAD_PORT}/?apiToken=<token> once; the SPA keeps it.
FAD_API_TOKEN=

# Unlocks the encrypted keyring file (bank passwords + the DB field-encryption
# key) under ${FAD_DATA_DIR}/keyring. Lose it and every stored credential is gone.
KEYRING_CRYPTFILE_PASSWORD=

# Optional: VNC view of the scraper's display (headed scrapes). Empty = off.
VNC_PASSWORD=

FAD_DATA_DIR=./data
FAD_PORT=8090
FAD_VNC_PORT=5909
# Host headers the backend accepts (add a proxy hostname here if you add one).
ALLOWED_HOSTS=localhost,127.0.0.1

# Scraper behaviour (fork additions, see docker/README.md)
FAD_SCRAPER_SHOW_BROWSER=1
FAD_SCRAPER_NATIVE_UA=1
